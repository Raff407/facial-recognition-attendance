# Python / tooling
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db

# Model weights (download separately if needed)
*.pt
yolo-Weights/
